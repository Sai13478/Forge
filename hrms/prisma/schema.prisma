datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id
  email String @unique
}

model Employee {
  id   Int    @id
  name String
}

model LeaveRequest {
  id     Int    @id
  reason String
}

model Payroll {
  id     Int   @id
  amount Float
}
